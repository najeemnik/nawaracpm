# ============================================================
# Nawara Studio — CPM
# ============================================================
# قاعدهٔ اصلی: هیچ دادهٔ واقعی، فایل آپلودشده، یا رمزی
# نباید وارد مخزن Git شود. مخزن فقط شامل کد و مستندات است.
# ============================================================

# ---------- ذخیره‌سازی خصوصی (دیتابیس و فایل‌ها) ----------
# محتویات این پوشه‌ها هرگز وارد Git نمی‌شوند،
# اما خودِ فایل‌های .htaccess که دسترسی مستقیم را می‌بندند
# باید در مخزن بمانند، چون بخشی از کد امنیتی پروژه هستند.
/data/*
!/data/.htaccess
/uploads/*
!/uploads/.htaccess
/storage/
/backups/
/logs/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db

# ---------- تنظیمات محیطی و رمزها ----------
.env
.env.*
!.env.example
*.key
*.pem
*.p12

# ---------- لاگ‌ها ----------
*.log
error_log
php_error.log

# ---------- وابستگی‌ها ----------
/vendor/
/node_modules/
composer.lock

# ---------- فایل‌های سیستم‌عامل و ویرایشگر ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---------- ویرایشگرها ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- فایل‌های موقت ----------
*.tmp
*.temp
*.bak
*.orig
